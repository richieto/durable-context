{
  "name": "durable-context-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for Durable Context editions and reference-docs — agent skills and scaffolds for planning and release-anchored documentation.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "publish:dry-run:durable": "npm publish --dry-run --workspace durable-context",
    "publish:durable": "npm publish --workspace durable-context",
    "publish:dry-run:solo": "npm publish --dry-run --workspace durable-context-solo",
    "publish:solo": "npm publish --workspace durable-context-solo",
    "publish:dry-run:reference": "npm publish --dry-run --workspace reference-docs",
    "publish:reference": "npm publish --workspace reference-docs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agents",
    "ai",
    "documentation",
    "working-context",
    "reference"
  ]
}
